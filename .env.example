# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/outbound_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Phase 0 - generate real secrets before production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# Server
NODE_ENV=development
PORT=3001

# Feature gating (Phase 6). false = all features unlocked (beta default).
OUTBOUND_GATING_ENABLED=false

# Cloudflare Turnstile (trip intake anti-abuse). Optional in dev — verification skipped if secret unset.
TURNSTILE_SECRET_KEY=       # Cloudflare Turnstile secret key (server-side verification)
TURNSTILE_SITE_KEY=         # Cloudflare Turnstile site key (client-side widget — used by frontend)

# Phase 3 — LLM (AWS Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional overrides (defaults are Claude Haiku/Sonnet 4.5 inference profiles)
# BEDROCK_HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_SONNET_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Phase 3 — Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App URL (for verification links, email CTAs)
OUTBOUND_APP_URL=http://localhost:8081
# API base (PDF download links in draft emails)
OUTBOUND_API_URL=http://localhost:3001

# Phase 3 — Email (Postmark) — legacy placeholder; prefer Resend
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_INBOUND_ADDRESS=

# Phase 3 — Workflow Orchestration (n8n Cloud)
N8N_WEBHOOK_URL=

# Phase 3 — Booking (Duffel)
DUFFEL_API_TOKEN=

# Phase 3 — Admin dashboard (comma-separated operator emails)
ADMIN_EMAILS=

# Phase 3 — Business Verification (Google Places) — wired later
GOOGLE_PLACES_API_KEY=
