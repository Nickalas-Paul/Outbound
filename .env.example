# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/outbound_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Phase 0 - generate real secrets before production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Where the API redirects after Google OAuth (tokens exchanged via POST /api/auth/exchange)
OUTBOUND_CLIENT_AUTH_CALLBACK=http://localhost:8081/auth/callback
# Web client ID for native Google Sign-In (same as GOOGLE_CLIENT_ID for the web OAuth client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-client-id

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# Server
NODE_ENV=development
PORT=3001

# Feature gating (Phase 6). false = all features unlocked (beta default).
OUTBOUND_GATING_ENABLED=false

# Cloudflare Turnstile (trip intake anti-abuse).
# Test keys for development; real keys in Phase 5.
# Site: 1x00000000000000000000AA  Secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional override for native WebView page (defaults to ${API}/api/intake/turnstile)
# EXPO_PUBLIC_TURNSTILE_PAGE_URL=http://localhost:3001/api/intake/turnstile

# Phase 3 — LLM (AWS Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional overrides (defaults are Claude Haiku/Sonnet 4.5 inference profiles)
# BEDROCK_HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_SONNET_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Phase 3 — Email (Resend)
RESEND_API_KEY=
# Empty = Resend sandbox sender (onboarding@resend.dev)
RESEND_FROM_EMAIL=

# App URL (for verification links, email CTAs) — required; no localhost fallback in URL builders
OUTBOUND_APP_URL=http://localhost:8081
# API base (PDF download links in draft emails) — required
OUTBOUND_API_URL=http://localhost:3001
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3001

# Phase 3 — Workflow Orchestration (n8n Cloud)
# Not yet used — reserved for future phase
N8N_WEBHOOK_URL=

# Phase 3 — Booking (Duffel)
DUFFEL_API_TOKEN=

# Phase 3 — Admin dashboard (comma-separated operator emails)
ADMIN_EMAILS=

# Phase 3 — Business Verification (Google Places)
# Not yet used — reserved for future phase
GOOGLE_PLACES_API_KEY=
