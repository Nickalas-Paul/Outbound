# Copy from repo root .env or set locally for API-only runs.
# See root .env.example for the full list.

# Feature gating (Phase 6). false = all features unlocked (beta default).
OUTBOUND_GATING_ENABLED=false

# Cloudflare Turnstile (trip intake).
# Test keys for development; real keys in Phase 5.
# Site: 1x00000000000000000000AA  Secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Phase 3 — Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App URL (for verification links, email CTAs) — required; no localhost fallback
OUTBOUND_APP_URL=http://localhost:8081
OUTBOUND_API_URL=http://localhost:3001
OUTBOUND_CLIENT_AUTH_CALLBACK=http://localhost:8081/auth/callback
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
