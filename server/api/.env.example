# Copy from repo root .env or set locally for API-only runs.
# See root .env.example for the full list.

# Feature gating (Phase 6). false = all features unlocked (beta default).
OUTBOUND_GATING_ENABLED=false

# Cloudflare Turnstile (trip intake). Optional in dev — verification skipped if secret unset.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Phase 3 — Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App URL (for verification links, email CTAs)
OUTBOUND_APP_URL=http://localhost:8081
